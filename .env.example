# =================================================================
# Givova Transportes - Sistema Interno de Monitoramento de PCs
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# =================================================================

# Ambiente da aplicação (production / development)
FLASK_ENV=production

# Chave secreta para assinatura de cookies e sessões administrativas
# Gere uma chave segura em produção (ex: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=altere_para_uma_chave_secreta_longa_e_aleatoria_em_producao

# Token de autenticação seguro exigido de todos os agentes de monitoramento
# O agente deve enviar este mesmo valor no header 'X-Agent-Token'
AGENT_SECRET_TOKEN=givova_agent_token_seguro_producao_2026

# Conexão com o Banco de Dados
# Padrão: SQLite local (ideal para deploy rápido e ambientes locais)
# Produção (PostgreSQL): postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=sqlite:///monitoramento.db

# Credenciais do Administrador Inicial (criado automaticamente se não existir)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GivovaAdmin@2026!

# Parâmetros de Monitoramento e Status
# Tempo em segundos sem comunicação para considerar o computador Offline
OFFLINE_THRESHOLD_SECONDS=30

# Limiares de Alertas Técnicos (valores em porcentagem)
CPU_ALERT_PERCENT=90.0
RAM_ALERT_PERCENT=90.0
DISK_ALERT_PERCENT=90.0

# Retenção de histórico de métricas (em dias) para evitar crescimento excessivo do banco
METRICS_RETENTION_DAYS=7

# Configurações de Rede / Hospedagem
HOST=0.0.0.0
PORT=5000
